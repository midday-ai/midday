# Backend: existing Supabase deployments remain the default.
# Set to local in every app environment to use Postgres + better-auth + S3 + SSE.
NEXT_PUBLIC_BACKEND_PROVIDER=supabase

# Resend
RESEND_API_KEY=

# Supabase
SUPABASE_SECRET_KEY=
SUPABASE_URL=

# Local Postgres (docker compose) — see docs/local-development.md
DATABASE_PRIMARY_URL=postgresql://postgres:postgres@localhost:5432/midday
DATABASE_PRIMARY_POOLER_URL=postgresql://postgres:postgres@localhost:5432/midday
DATABASE_SSL=disable
# Optional local realtime connection; must be direct (not a transaction pooler).
# Defaults to DATABASE_PRIMARY_URL when omitted.
DATABASE_LISTEN_URL=

# Read replicas — only the current region's replica is used at runtime
DATABASE_FRA_URL="" # (Frankfurt)
DATABASE_SJC_URL="" # (San Jose)
DATABASE_IAD_URL="" # (North Virginia)

# Used in drizzle-kit
# Direct, non-pooled connection used by migrations
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/midday

# Banking Providers
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
ENABLEBANKING_APPLICATION_ID=
ENABLE_BANKING_KEY_CONTENT=
ENABLEBANKING_REDIRECT_URL=
TELLER_CERT_BASE64=
TELLER_KEY_BASE64=
TELLER_SIGNING_SECRET=

# R2 Storage (institution logos)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Logo.dev (fallback logos for institutions)
LOGO_DEV_TOKEN=

# LLMS
OPENAI_API_KEY=

# Config
ALLOWED_API_ORIGINS="http://localhost:3001"
LOG_LEVEL=debug
INVOICE_JWT_SECRET=
MIDDAY_ENCRYPTION_KEY=
MIDDAY_DASHBOARD_URL="http://localhost:3001"

# Polar
POLAR_ACCESS_TOKEN=
POLAR_ENVIRONMENT=sandbox
POLAR_WEBHOOK_SECRET=

# Environment
NODE_ENV=development

# Railway (set automatically in production)
# RAILWAY_ENVIRONMENT=production
# RAILWAY_REPLICA_REGION=europe-west4-drams3a

# Redis Cache (Upstash multi-region — reads from nearest replica, writes to primary)
REDIS_URL=redis://localhost:6379

# Google
GOOGLE_GENERATIVE_AI_API_KEY=

# Redis Queue (Railway internal — used by BullMQ)
REDIS_QUEUE_URL=redis://localhost:6379

# Logger
LOG_PRETTY=true

# Inbox Webhook
INBOX_WEBHOOK_USERNAME=
INBOX_WEBHOOK_PASSWORD=

# File Key Secret
FILE_KEY_SECRET=secret

# Slack Integration
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URL=http://localhost:3003/apps/slack/oauth-callback
SLACK_STATE_SECRET=
SLACK_SIGNING_SECRET=
# Optional but recommended when storing multi-workspace Slack installations
SLACK_ENCRYPTION_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_BOT_USERNAME=
# Optional for self-hosted Telegram API gateways
TELEGRAM_API_BASE_URL=

# Outlook
OUTLOOK_CLIENT_ID=<your-client-id>
OUTLOOK_CLIENT_SECRET=<your-client-secret>
OUTLOOK_REDIRECT_URI=http://localhost:3003/apps/outlook/oauth-callback

# WhatsApp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Sendblue (iMessage/SMS)
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
SENDBLUE_WEBHOOK_SECRET=
SENDBLUE_STATUS_CALLBACK_URL=

# Mistral
MISTRAL_API_KEY=

# Xero
XERO_CLIENT_ID=your_client_id_here
XERO_CLIENT_SECRET=your_client_secret_here
XERO_OAUTH_REDIRECT_URL=http://localhost:3003/apps/xero/oauth-callback

# QuickBooks
QUICKBOOKS_CLIENT_ID=your_client_id
QUICKBOOKS_CLIENT_SECRET=your_client_secret
QUICKBOOKS_OAUTH_REDIRECT_URL=http://localhost:3003/apps/quickbooks/oauth-callback
QUICKBOOKS_ENVIRONMENT=sandbox

# Fortnox
FORTNOX_CLIENT_ID=your_client_id_here
FORTNOX_CLIENT_SECRET=your_client_secret_here
FORTNOX_OAUTH_REDIRECT_URL=http://localhost:3003/apps/fortnox/oauth-callback

# Stripe
STRIPE_SECRET_KEY=your_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_publishable_key_here
STRIPE_CONNECT_CLIENT_ID=your_connect_client_id_here
STRIPE_CONNECT_WEBHOOK_SECRET=your_webhook_secret_here

# Midday API URL
MIDDAY_API_URL=http://localhost:3003

# GitHub (Desktop updater proxy)
GITHUB_RELEASE_TOKEN=

# Trigger.dev
TRIGGER_SECRET_KEY=

# Internal API Key
INTERNAL_API_KEY=

# Anthropic

# Composio (AI tool connectors)
COMPOSIO_API_KEY=

# Authentication
AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks
AUTH_JWT_ISSUER=http://localhost:3001
AUTH_JWT_AUDIENCE=midday-api

# S3-compatible storage (local MinIO; use R2 endpoint and region=auto in production)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=midday
STORAGE_SECRET_ACCESS_KEY=midday-secret
STORAGE_FORCE_PATH_STYLE=true
STORAGE_BUCKET_VAULT=vault
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_APPS=apps
STORAGE_PUBLIC_URL_AVATARS=http://localhost:9000/avatars
STORAGE_PUBLIC_URL_APPS=http://localhost:9000/apps
# Browser vault upload limit (bytes); avatars/apps remain 5 MiB
STORAGE_MAX_UPLOAD_BYTES_VAULT=104857600

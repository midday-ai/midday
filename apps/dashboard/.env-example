# Backend: existing Supabase deployments remain the default.
# Set to local in every app environment to use Postgres + better-auth + S3 + SSE.
NEXT_PUBLIC_BACKEND_PROVIDER=supabase

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ID=
NEXT_PUBLIC_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3003
SUPABASE_SECRET_KEY=

# Resend
RESEND_API_KEY=
RESEND_AUDIENCE_ID=


# Redis Cache (Upstash multi-region — reads from nearest replica, writes to primary)
REDIS_URL=redis://localhost:6379

# Teller (Base 64 encoded certificate)
TELLER_CERTIFICATE=
TELLER_CERTIFICATE_PRIVATE_KEY=
NEXT_PUBLIC_TELLER_APPLICATION_ID=
NEXT_PUBLIC_TELLER_ENVIRONMENT=
TELLER_SIGNING_SECRET=

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
NEXT_PUBLIC_PLAID_ENVIRONMENT=

# Plain
PLAIN_API_KEY=

# OpenAI
OPENAI_API_KEY=

# OpenPanel
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
OPENPANEL_SECRET_KEY=

# Azure
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Google Maps
NEXT_PUBLIC_GOOGLE_API_KEY=

# Invoice
INVOICE_JWT_SECRET=secret

# Midday Cache
MIDDAY_CACHE_API_SECRET=

# Polar
POLAR_ACCESS_TOKEN=
POLAR_ENVIRONMENT=sandbox
POLAR_WEBHOOK_SECRET=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=

# File Key Secret
FILE_KEY_SECRET=secret

# Gmail
GMAIL_CLIENT_ID=<your-client-id>
GMAIL_CLIENT_SECRET=<your-client-secret>
GMAIL_REDIRECT_URI=http://localhost:3003/apps/gmail/oauth-callback

# Outlook
OUTLOOK_CLIENT_ID=<your-client-id>
OUTLOOK_CLIENT_SECRET=<your-client-secret>
OUTLOOK_REDIRECT_URI=http://localhost:3003/apps/outlook/oauth-callback

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_publishable_key_here

# Desktop deep link scheme (midday, midday-dev, midday-staging)
NEXT_PUBLIC_DESKTOP_SCHEME=midday-dev

# Next.js Server Actions encryption key (base64-encoded, 32 bytes)
# Must be identical across all replicas/regions to prevent "Failed to find Server Action" errors.
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Messaging app connect flows
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_SENDBLUE_NUMBER=

# Authentication (providers are enabled only when both credentials are set)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
DATABASE_PRIMARY_URL=postgresql://postgres:postgres@localhost:5432/midday
DATABASE_SSL=disable
AUTH_EMAIL_FROM="Midday <middaybot@midday.ai>"
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_APPLE_CLIENT_ID=
AUTH_APPLE_CLIENT_SECRET=
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
AUTH_MICROSOFT_TENANT_ID=common
AUTH_JWT_AUDIENCE=midday-api
NEW_USER_CUTOFF=

# Authenticator app label
AUTH_TOTP_ISSUER=Midday

# Public storage origins bypass image CDN rewriting
NEXT_PUBLIC_STORAGE_PUBLIC_HOSTS=localhost:9000
NEXT_PUBLIC_STORAGE_PUBLIC_URL_AVATARS=http://localhost:9000/avatars
NEXT_PUBLIC_STORAGE_PUBLIC_URL_APPS=http://localhost:9000/apps

# Enables local SSE when the local backend is selected
NEXT_PUBLIC_REALTIME_ENABLED=true
